# ================================================================
# NeuroStack AI — Backend Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env with real credentials.
# ================================================================

# ── Server ──────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:3000

# ── Redis ────────────────────────────────────────────────────────
# Used for rate limiting, caching, and background job queue (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# ── Rate Limiting ────────────────────────────────────────────────
# Requests per 60-second window (per user ID or IP)
RATE_LIMIT_DEFAULT_LIMIT=100
# Stricter limit for /api/auth/login and /api/auth/register
RATE_LIMIT_AUTH_LIMIT=15

# ── MongoDB ─────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ── Google Gemini ────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Pinecone ─────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=your_pinecone_index_name

# ── Neo4j (optional — Graph Explorer works without it) ───────────
# Use the AuraDB connection string (neo4j+s://) for cloud instances.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── Email Verification (optional) ────────────────────────────────
# Without SMTP, register returns a devVerificationUrl in the response.
APP_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NeuroStack AI <no-reply@example.com>

# ── Google OAuth (optional) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
